# Database
POSTGRES_USER=tts_agent
POSTGRES_PASSWORD=tts_agent_secret
POSTGRES_DB=tts_agent
DATABASE_URL=postgres://tts_agent:tts_agent_secret@localhost:5432/tts_agent?sslmode=disable
DATABASE_READONLY_URL=postgres://agent_readonly:readonly_secret@localhost:5432/tts_agent?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=change-me-to-a-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email verification. Use "log" locally; use any standards-compliant SMTP provider in production.
EMAIL_PROVIDER=log
EMAIL_FROM=经营分析助手 <no-reply@example.com>
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_TLS_MODE=starttls
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_CODE_EXPIRE_MINUTES=10
EMAIL_CODE_RESEND_SECONDS=60
EMAIL_CODE_MAX_ATTEMPTS=5
EMAIL_CODE_MAX_PER_HOUR=5

# DeepSeek LLM
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=30

# Embedding
EMBEDDING_DIMENSION=1536

# App
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DEFAULT_DOMAIN=ecommerce
DOMAINS_PATH=domains
STATEMENT_TIMEOUT_MS=10000
MAX_AGENT_RETRIES=3
RATE_LIMIT_PER_MINUTE=20
WORKER_CONCURRENCY=2
WORKER_USER_CONCURRENCY=1
WORKER_POLL_MS=500
WORKER_LEASE_SECONDS=60
WORKER_HEARTBEAT_SECONDS=10
JOB_MAX_ATTEMPTS=3
JOB_BACKOFF_BASE_SECONDS=2
JOB_QUEUE_LIMIT=1000
USER_ACTIVE_JOB_LIMIT=3
PORT=8000
